{
  // Isolated copy for the DSH 0.1.5-rc.1 profile.
  //
  // The original relative `paths` block mapped @deepseek-ai/* at the sibling
  // harness checkout (../deepseek-harness), which is pinned to the OLD core
  // (rc.2) and no longer exports the packages this plugin needs. This copy
  // resolves every dependency from its own node_modules instead — the shared
  // installation fallback plus the few locally installed type packages.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // 关键：从符号链接位置解析依赖，而不是解析到真实路径（CLI 安装树里没有客户端包）
    "preserveSymlinks": true
  },
  "include": ["src"]
}
